{
  "name": "Limitless AI",
  "short_name": "Limitless",
  "description": "Private AI chat, image, video, animation, and local project workflows.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#080808",
  "theme_color": "#080808",
  "orientation": "any",
  "categories": ["productivity", "developer", "graphics_and_design", "utilities"],
  "icons": [
    {
      "src": "/limitless-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/limitless-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/limitless-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
