{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limitless AI",
  "version": "2.0.0",
  "identifier": "com.limitless.ai.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Limitless AI",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.supabase.co https://openrouter.ai https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com; object-src 'none'; base-uri 'none'; frame-src 'self' blob:",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "createUpdaterArtifacts": false,
    "publisher": "Limitless AI"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["limitless-ai"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    }
  }
}
