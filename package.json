{
  "name": "limitless-ai",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:vercel": "next build",
    "vercel-build": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "test:contracts": "node --test tests/contracts.test.mjs tests/workspace-scope-privacy.test.mjs",
    "test:artifacts": "node --import tsx --test tests/artifacts.test.ts",
    "test:finale": "node --import tsx --test tests/finale.test.ts",
    "test:security": "node --test companion/security.test.mjs",
    "test": "npm run typecheck && npm run test:contracts && npm run test:artifacts && npm run test:finale && npm run test:security && npm run build && node --test tests/rendered-html.test.mjs",
    "setup": "node scripts/setup-limitless.mjs",
    "validate:finale": "node scripts/validate-finale.mjs",
    "validate:supabase": "node scripts/validate-supabase.mjs",
    "validate:native": "node scripts/validate-native.mjs",
    "release:validate": "npm run test && npm run lint && npm run validate:finale && npm run validate:supabase && npm run validate:native && npm run build:vercel && npm audit --omit=dev",
    "release:handoff": "node scripts/prepare-final-handoff.mjs",
    "release:archive": "node scripts/prepare-final-release.mjs",
    "release:verify": "node scripts/verify-final-release.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "docx": "9.7.1",
    "jszip": "3.10.1",
    "lucide-react": "1.26.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "6.2.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  },
  "type": "module",
  "displayName": "Limitless AI"
}
