# Public Supabase project settings. Safe to expose in the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional client-safe Pollinations App Key for budgeted hosted AI video.
# Only use a publishable pk_ key. Never place an sk_ key here.
NEXT_PUBLIC_POLLINATIONS_PUBLISHABLE_KEY=pk_your_publishable_app_key

# Required guard for the optional Pollinations browser route. Set a finite integer.
# 0 keeps the route off. Each hosted run still requires explicit in-app consent.
NEXT_PUBLIC_POLLINATIONS_RUN_BUDGET=0

# Never add a Supabase service-role key, Pollinations sk_ key, or OpenRouter key here.
# Each user enters their own OpenRouter key, which is encrypted on their device.
